# All dependencies of lookie_ros; lookie_ros itself is cloned first.
repositories:
  kstone:
    type: git
    url: https://github.com/AgilexOpensource/kstone.git
    version: main
  kstone_ros:
    type: git
    url: https://github.com/AgilexOpensource/kstone_ros.git
    version: main
  lookie_description:
    type: git
    url: https://github.com/AgilexOpensource/lookie_description.git
    version: master
  xr_media_ros:
    type: git
    url: https://github.com/AgilexOpensource/xr_media_ros.git
    version: main
  head_ros:
    type: git
    url: https://github.com/AgilexOpensource/head_ros.git
    version: main
  lift_ros:
    type: git
    url: https://github.com/AgilexOpensource/lift_ros.git
    version: main
  fold_ros:
    type: git
    url: https://github.com/AgilexOpensource/fold_ros.git
    version: main
  agx_arm_ros:
    type: git
    url: https://github.com/agilexrobotics/agx_arm_ros.git
    version: ros2
  # Chassis drivers (Neo differential, Trio omnidirectional).
  lookie_neo_base:
    type: git
    url: https://github.com/AgilexOpensource/lookie_neo_base.git
    version: main
  lookie_trio_base:
    type: git
    url: https://github.com/AgilexOpensource/lookie_trio_base.git
    version: main
  ugv_sdk:
    type: git
    url: https://github.com/westonrobot/ugv_sdk.git
    version: main
